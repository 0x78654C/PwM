<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- The payload fixture exercises three-part and four-part ZIP versions. -->
    <Version>3.2.3.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UpdateCleanup\UpdateCleanup.csproj" />
    <Compile Include="..\PwM\Updating\*.cs" Exclude="..\PwM\Updating\UpdateController.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\AutoUpdater\PackageInstaller.cs" Link="PackageInstaller.cs" />
    <Compile Include="..\AutoUpdater\UpdateOptions.cs" Link="UpdateOptions.cs" />
    <Compile Include="..\AutoUpdater\UpdaterForm.cs" Link="UpdaterForm.cs" />
  </ItemGroup>
</Project>
